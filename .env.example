# ========================================================
# FUNPRINT — ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# 1. NEON POSTGRESQL DATABASE
# Pooled connection string (recommended for serverless/Next.js)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Unpooled direct connection string (for migrations)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# 2. NEON S3-COMPATIBLE OBJECT STORAGE
AWS_ENDPOINT_URL_S3="https://br-example.storage.region.aws.neon.tech"
AWS_ACCESS_KEY_ID="your_neon_s3_access_key_id"
AWS_SECRET_ACCESS_KEY="your_neon_s3_secret_access_key"
AWS_REGION="ap-southeast-1"
S3_BUCKET_NAME="assets"

# 3. NEON AUTH & FUNCTIONS (OPTIONAL EXTENSIONS)
NEON_AUTH_BASE_URL="https://br-example.auth.region.aws.neon.tech"
NEON_AUTH_JWKS_URL="https://br-example.auth.region.aws.neon.tech/.well-known/jwks.json"
NEON_FUNCTION_HELLO_BASE_URL="https://br-example-hello.compute.region.aws.neon.tech"

# 4. CUSTOMER AUTHENTICATION & SESSIONS
JWT_SECRET="generate_a_secure_random_64_char_string"
COOKIE_DOMAIN="" # optional: yourdomain.com in production

# 5. ADMIN CREDENTIALS (DEFAULT SEED)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your_secure_admin_password"
ADMIN_JWT_SECRET="generate_a_secure_random_admin_secret"

# 6. MERCHANT MANUAL UPI PAYMENT DETAILS
NEXT_PUBLIC_UPI_ID="yourbusiness@upi"
NEXT_PUBLIC_UPI_NAME="FunPrint"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# 7. NODEMAILER SMTP CONFIGURATION
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="contact@funprint.in"
SMTP_PASSWORD="your_smtp_app_password"
SMTP_FROM="FunPrint Orders <contact@funprint.in>"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# 8. GOOGLE ANALYTICS 4
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# 9. PUBLIC SITE METADATA
NEXT_PUBLIC_SITE_URL="https://www.funprint.in"